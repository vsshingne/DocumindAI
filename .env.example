# Copy to .env and run scripts/init_env.py to generate local secrets.
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=documind
POSTGRES_USER=documind
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRY_MINUTES=30
# This URL is for a locally running backend. Compose supplies its internal URL.
DATABASE_URL=postgresql+psycopg://documind:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/documind
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]
STORAGE_ROOT=data/documents
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=10
HEALTH_TIMEOUT_SECONDS=3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.35
