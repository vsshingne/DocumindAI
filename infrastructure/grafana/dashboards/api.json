{
  "uid": "documind-api", "title": "DocuMind API", "schemaVersion": 40,
  "version": 1, "refresh": "15s", "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Requests / second", "type": "timeseries",
     "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(rate(documind_http_requests_total[5m]))"}]},
    {"id": 2, "title": "API p95 latency (seconds)", "type": "timeseries",
     "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(documind_http_duration_seconds_bucket[5m])))"}]},
    {"id": 3, "title": "Server errors / second", "type": "timeseries",
     "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(rate(documind_http_requests_total{status=~\"5..\"}[5m]))"}]},
    {"id": 4, "title": "Scrape availability", "type": "timeseries",
     "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "up{job=~\"documind-api|qdrant\"}"}]}
  ]
}
